+static bool copy_arg(char* dst, size_t dst_len, const char* value)
+{
+    if (dst == nullptr || dst_len == 0 || value == nullptr || strlen(value) >= dst_len) {
+        return false;
+    }
+    snprintf(dst, dst_len, "%s", value);
+    return true;
+}
+
+static void print_usage(const char* prog)
+{
