+        "Usage: %s [options]\n"
+        "  --uu-bind IP          local Uu/server address\n"
+        "  --uu-port PORT        local Uu UDP port\n"
+        "  --pc5-local IP        local PC5/RSU address\n"
+        "  --pc5-peer IP         remote PC5/OBU address\n"
+        "  --exp NAME            experiment label\n"
+        "  --no-color            disable ANSI colors\n",
+        prog);
+}
