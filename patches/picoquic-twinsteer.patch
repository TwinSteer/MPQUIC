+        path_x == NULL) {
+        return picoquic_format_ack_frame(
+            cnx, bytes, bytes_max, more_data,
+            current_time, pc, is_opportunistic);
+    }
+
+    int need_time_stamp =
+        (pc == picoquic_packet_context_application &&
+         cnx->is_time_stamp_sent);
+
+    uint8_t* ack_begin = bytes;
+
+    bytes = picoquic_format_ack_frame_in_context(
+        cnx,
+        bytes,
+        bytes_max,
+        more_data,
+        current_time,
+        &path_x->ack_ctx,
+        &need_time_stamp,
+        path_x->unique_path_id,
+        is_opportunistic);
+
+    /*
+    * 실제 PATH_ACK frame이 생성된 경우에만 카운트.
+    * bytes가 증가하지 않았다면 ACK을 넣지 않은 것이므로 세지 않는다.
+    */
+    if (bytes != NULL && bytes > ack_begin) {
+        path_x->nb_path_ack_sent++;
