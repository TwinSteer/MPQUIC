+    uint64_t current_time,
+    uint64_t* next_wake_time,
+    picoquic_packet_context_enum pc,
+    int is_opportunistic)
+{
+    if (!cnx->is_multipath_enabled ||
+        pc != picoquic_packet_context_application ||
+        path_x == NULL) {
+        return picoquic_is_ack_needed(
+            cnx, current_time, next_wake_time,
+            pc, is_opportunistic);
+    }
+
+    int path_index = -1;
+
+    for (int i = 0; i < cnx->nb_paths; i++) {
+        if (cnx->path[i] == path_x) {
+            path_index = i;
+            break;
+        }
+    }
+
+    if (path_index < 0) {
+        return 0;
+    }
+
+    return picoquic_is_ack_needed_in_ctx(
+        cnx,
+        &path_x->ack_ctx,
+        current_time,
+        path_index,
+        next_wake_time,
+        pc,
