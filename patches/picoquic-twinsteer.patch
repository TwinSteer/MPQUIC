+    int ack_still_needed = 0;
+    int ack_after_fin = 0;
+
+    for (int i = 0; i < cnx->nb_paths; i++) {
+        ack_still_needed |=
+            cnx->path[i]->ack_ctx.act[is_opportunistic].ack_needed;
+
+        ack_after_fin |=
+            cnx->path[i]->ack_ctx.act[is_opportunistic].ack_after_fin;
+    }
+
+    cnx->ack_ctx[pc].act[is_opportunistic].ack_needed =
+        ack_still_needed;
+
+    cnx->ack_ctx[pc].act[is_opportunistic].ack_after_fin =
+        ack_after_fin;
+
+    return bytes;
+}
