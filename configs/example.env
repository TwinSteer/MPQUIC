# Copy this file to configs/local.env and edit for your setup.

# Path to the vendor Ettifos SIRIUS SDK directory.
SIRIUS_SDK_DIR=/home/user/Documents/sdk

# Sender -> receiver Uu path.
UU_RECEIVER_IP=100.73.62.97
UU_RECEIVER_PORT=36230

# PC5 addresses used by the OBU (sender) and RSU (receiver).
PC5_SENDER_IP=10.254.52.19
PC5_RECEIVER_IP=10.254.52.18

# Sender-side gpsd and camera.
GPS_HOST=192.168.70.102
GPS_PORT=4545
CAMERA_INDEX=0

# Optional experiment label used in terminal/log filenames.
EXP_NAME=rr_reference
